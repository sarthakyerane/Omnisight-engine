# ─── Capture Daemon ────────────────────────────────────────────────────────────
IDLE_TIMEOUT_SECONDS=30
CAPTURE_INTERVAL_SECONDS=2.0
PHASH_THRESHOLD=5

# Data directory (absolute path recommended for service deployments)
# DATA_DIR=/home/user/.riom/data

# ─── Privacy ───────────────────────────────────────────────────────────────────
# JSON-formatted list; pydantic-settings will parse it automatically
DENYLIST_APPS='["1password", "bitwarden", "lastpass", "keepass", "dashlane", "incognito", "private browsing", "bank", "finance"]'

# ─── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite:///./ambient_memory.db"
REDIS_URL="redis://localhost:6379/0"
CHROMA_PERSIST_DIR="./chroma_db"

# ─── AI / LLM ───────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY="gsk_..."

# Fast and capable — good default for summarisation
GROQ_MODEL="llama-3.3-70b-versatile"

# Maximum tokens in LLM response per frame
LLM_MAX_TOKENS=256

# LLM temperature (0 = deterministic summaries)
LLM_TEMPERATURE=0.0

# Max retries on OpenAI API errors before giving up on a frame
LLM_MAX_RETRIES=3

# ─── OCR ───────────────────────────────────────────────────────────────────────
# Path to tesseract binary (Windows example). Leave blank to auto-detect.
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"

# ─── Embeddings ────────────────────────────────────────────────────────────────
# HuggingFace sentence-transformer model for semantic search
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST="127.0.0.1"
API_PORT=8000

# Maximum number of results returned per semantic query
QUERY_TOP_K=10
